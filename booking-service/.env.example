DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/scheduler

# Cache-aside availability (must NOT host Redlock — separate failure domain).
REDIS_CACHE_URL=redis://localhost:6379

# Five independent Redis masters for Redlock (3-of-5 quorum). Match ports in docker-compose.dev.yml when running compose locally.
REDLOCK_NODES=redis://localhost:6381,redis://localhost:6382,redis://localhost:6383,redis://localhost:6384,redis://localhost:6385
