# Development image — hot reload via `nest start --watch`.
# Source is bind-mounted from the host at runtime; node_modules is a named volume
# so the container's install isn't shadowed by the host directory.

FROM node:22-alpine

WORKDIR /app

# Install deps first so the layer is cached when only source changes.
COPY package.json package-lock.json ./
RUN npm ci

# Source is bind-mounted at runtime; this COPY is just so the image can boot
# standalone (e.g. `docker run` without compose) for sanity checks.
COPY . .

EXPOSE 8080

CMD ["sh", "-c", "npx prisma migrate deploy && npm run start:dev"]
